{
  "toolChoice": {
    "auto": {}
  },
  "tools": [
    {
      "toolSpec": {
        "description": "Read an exact inclusive line range from one hash-verified BEFORE or AFTER source file. Paths are normalized repository-relative paths.",
        "inputSchema": {
          "json": {
            "additionalProperties": false,
            "properties": {
              "end_line": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer"
              },
              "version": {
                "enum": [
                  "before",
                  "after"
                ],
                "type": "string"
              }
            },
            "required": [
              "version",
              "path",
              "start_line",
              "end_line"
            ],
            "type": "object"
          }
        },
        "name": "read_source",
        "strict": true
      }
    },
    {
      "toolSpec": {
        "description": "Literal (not regex) search across hash-verified BEFORE or AFTER source. Optionally restrict to one normalized repository-relative path. Returns bounded exact surrounding source and provenance.",
        "inputSchema": {
          "json": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "version": {
                "enum": [
                  "before",
                  "after"
                ],
                "type": "string"
              }
            },
            "required": [
              "version",
              "query"
            ],
            "type": "object"
          }
        },
        "name": "search_source",
        "strict": true
      }
    },
    {
      "toolSpec": {
        "description": "Find exact Python module-level assignments, functions, or classes for one identifier in hash-verified source. Optionally restrict to one path. Reports unsupported, missing, oversized, and ambiguous resolution explicitly; use literal search_source as fallback.",
        "inputSchema": {
          "json": {
            "additionalProperties": false,
            "properties": {
              "identifier": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "version": {
                "enum": [
                  "before",
                  "after"
                ],
                "type": "string"
              }
            },
            "required": [
              "version",
              "identifier"
            ],
            "type": "object"
          }
        },
        "name": "find_definition",
        "strict": true
      }
    },
    {
      "toolSpec": {
        "description": "Find source locations that reference an identifier in the hash-verified BEFORE or AFTER repository snapshot. Returns exact source and provenance. References may be syntactic or lexical matches and are not automatically semantically related.",
        "inputSchema": {
          "json": {
            "additionalProperties": false,
            "properties": {
              "identifier": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "version": {
                "enum": [
                  "before",
                  "after"
                ],
                "type": "string"
              }
            },
            "required": [
              "version",
              "identifier"
            ],
            "type": "object"
          }
        },
        "name": "find_references",
        "strict": true
      }
    }
  ]
}
